# URL base del backend (sin /api al final), p. ej. https://canelaenramaback.onrender.com
# Vacía: las llamadas van a /api del mismo origen (en dev, vía proxy de Vite).
VITE_API_URL=

# Destino del proxy de desarrollo (solo `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8080

# Timeout de las peticiones en milisegundos.
VITE_API_TIMEOUT=20000

# Datos de contacto que se muestran en el sitio.
VITE_WHATSAPP=5492615790124
VITE_INSTAGRAM_URL=https://www.instagram.com/canelaenramamza
VITE_FACEBOOK_URL=https://www.facebook.com/canelaenramamza
